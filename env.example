# Copy this file to .env and fill in the values. Never commit .env.

# Backend
DATABASE_PATH=./backend/halalready.db
UPLOAD_DIR=./backend/uploads
BACKEND_URL=http://localhost:8000

# Connector: shared secret the connector sends to the backend
CONNECTOR_TOKEN=

# Messaging: set MESSAGING_CHANNEL to whatsapp, telegram or manual
MESSAGING_CHANNEL=manual

# Twilio WhatsApp (only if MESSAGING_CHANNEL=whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Telegram (only if MESSAGING_CHANNEL=telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Public address of the backend for incoming replies (tunnel URL)
PUBLIC_WEBHOOK_URL=
