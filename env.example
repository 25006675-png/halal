# Copy this file to .env and fill in the values. Never commit .env.

# Backend
DATABASE_PATH=./backend/halalready.db
UPLOAD_DIR=./backend/uploads
BACKEND_URL=http://localhost:8000
BUSINESS_ID=1

# Connector: shared secret the connector sends to the backend (X-Connector-Token).
# Leave empty to switch the check off during development.
CONNECTOR_TOKEN=
CONNECTOR_PORT=8001

# Through the ngrok tunnel only /webhooks/* answers. Set to 1 for a joint
# session where teammates use the whole API over the tunnel.
ALLOW_REMOTE=0

# Messaging: whatsapp, telegram or manual (manual sends nothing; safe default)
MESSAGING_CHANNEL=manual
# Re-send a WhatsApp message on Telegram if no reply after this many minutes
FALLBACK_AFTER_MINUTES=120

# Twilio WhatsApp (sandbox "from" number looks like +14155238886)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Telegram bot (from @BotFather). Send /start to the bot to see your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Chat that receives supplier messages when a supplier has no Telegram chat id (the demo phone)
TELEGRAM_FALLBACK_CHAT_ID=
# Owner alerts (Renewal Watch)
TELEGRAM_OWNER_CHAT_ID=
DEMO_OWNER_PHONE=

# Public address of the backend for incoming replies. scripts/tunnel.py sets
# this at runtime; only fill it in for a fixed (reserved) ngrok domain.
PUBLIC_WEBHOOK_URL=
